# Copy to .env (never commit it): cp .env.example .env. Where Landlords Stand uses no AI and no paid services, so
# everything here can be left empty at first; the rest of its settings are in config/settings.toml.
# After a change: bash /opt/wherelandlordsstand/deploy/update.sh

# ---- Going public (docs/LAUNCH.md) -------------------------------------------------------------------------------
# The site's address, once it has one, e.g. https://wherelandlordsstand.com (overrides [site] url).
LANDLORDS_SITE_URL=
# true only when the owner says the site is public: it removes the "test version" line, lets search engines in, and
# from then on new pages wait for approval by email (overrides [site] launched).
LANDLORDS_LAUNCHED=

# ---- The weekly email (docs/OPERATIONS.md, "The weekly update") ---------------------------------------------------
# The account that sends it: the server's Gmail address and app password. Copy them from the server's mail settings
# with the command in docs/DEPLOY.md ("The weekly email") rather than by hand.
LANDLORDS_SMTP_USER=
LANDLORDS_SMTP_PASSWORD=

# ---- Off-site copies of the nightly backup (Backblaze B2) --------------------------------------------------------
# The charity's sites share one bucket and key: copy them from Where MPs Stand's settings with the command in
# docs/DEPLOY.md ("Backups"), rather than by hand.
LANDLORDS_B2_BUCKET=
LANDLORDS_B2_KEY_ID=
LANDLORDS_B2_APPLICATION_KEY=
