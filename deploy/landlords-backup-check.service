# Checks every day that the nightly backup and its off-site copy are up to date (landlords backup-check): a backup
# timer that has stopped, or a copy that keeps failing, would otherwise go unnoticed. Installed by deploy/update.sh
# with landlords-backup-check.timer.
[Unit]
Description=Where Landlords Stand: check the backups are up to date
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where MPs Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherelandlordsstand/deploy
# Exits 1 when the last backup or off-site copy is over two days old, or the last off-site copy failed.
ExecStart=/usr/bin/docker compose run --rm --no-deps -T app landlords backup-check --in /backups
Nice=10
TimeoutStartSec=10min
