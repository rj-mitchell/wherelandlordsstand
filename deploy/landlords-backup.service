# Nightly copy of the one thing that can't be rebuilt: the state database (readers' reports of mistakes, missed
# searches). Copies land in /opt/wherelandlordsstand/deploy/backups. Installed by deploy/update.sh.
[Unit]
Description=Where Landlords Stand: back up the state database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherelandlordsstand/deploy
ExecStart=/usr/bin/docker compose run --rm -T app landlords backup --to /backups --keep 14
Nice=10
TimeoutStartSec=10min
