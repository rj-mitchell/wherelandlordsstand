# Fetch new published files, load and check them, and build the pages into a new folder in /data/builds, then email
# a link to approve them: nothing new goes live without the owner's approval (docs/OPERATIONS.md). The update runs in
# a one-off container and leaves its email in the outbox; deploy/run-update.sh then sends it with the server's shared
# mail.sh (deploy/send-mail.sh). Installed by deploy/update.sh with landlords-update.timer.
[Unit]
Description=Where Landlords Stand: weekly update
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where MPs Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherelandlordsstand/deploy
# Exits 1 when something needs attention or the email wasn't sent; each run's summary is appended to
# /data/updates.jsonl. One update at a time on the whole server: run-update.sh takes the lock every site's update
# takes, and waits for any other to finish rather than fail (Where MPs Stand's sync can take up to 6 hours), so the
# time allowed covers the wait.
ExecStart=/bin/bash /opt/wherelandlordsstand/deploy/run-update.sh
Nice=10
TimeoutStartSec=8h
