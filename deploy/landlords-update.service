# Fetch new published files, load and check them, and build the pages into a new folder in /data/builds, then email
# a link to approve them: nothing new goes live without the owner's approval (docs/OPERATIONS.md).
# Installed by deploy/update.sh with landlords-update.timer.
[Unit]
Description=Where Landlords Stand: weekly update
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where MPs Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherelandlordsstand/deploy
# Exits 1 when something needs attention; each run's summary is appended to /data/updates.jsonl.
ExecStart=/usr/bin/docker compose run --rm -T app landlords update
Nice=10
TimeoutStartSec=1h
