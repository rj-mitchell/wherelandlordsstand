[Unit]
Description=Where Landlords Stand: weekly update

[Timer]
# Thursday early morning, UTC: the regulator publishes on weekday mornings, and the other sites update nightly at
# other times.
OnCalendar=Thu *-*-* 04:47:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
